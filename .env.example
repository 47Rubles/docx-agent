# Пример локального окружения. Скопируй в .env и заполни значения.
# Сам файл .env в репозиторий НЕ попадает (см. .gitignore).
#
#   copy .env.example .env
#
# Значения читаются при старте приложения. Переменная, указанная
# в config/settings.yaml как ${ИМЯ}, подставляется из окружения.

# Ключ LLM-провайдера (Gemini). Тот же секрет, что используется в CI:
# Settings -> Secrets and variables -> Actions -> New repository secret.
LLM_API_KEY=

# Необязательные настройки провайдера — переопределяют значения из settings.yaml
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_MODEL=gemini-3.8-flash
