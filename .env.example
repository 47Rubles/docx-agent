# Пример локального окружения. Скопируй в .env и заполни значения.
# Сам файл .env в репозиторий НЕ попадает (см. .gitignore).
#
#   copy .env.example .env
#
# Значения читаются при старте приложения. Переменная, указанная
# в config/settings.yaml как ${ИМЯ}, подставляется из окружения.

# Ключ LLM-провайдера. Тот же секрет, что используется в CI:
# Settings -> Secrets and variables -> Actions -> New repository secret.
LLM_API_KEY=

# Необязательное: ключ Groq подхватится и по этому имени —
# провайдер сначала смотрит GROQ_API_KEY, затем общий LLM_API_KEY.
# GROQ_API_KEY=

# Необязательные настройки — переопределяют значения из config/settings.yaml.
# Провайдер по умолчанию берётся из конфига (groq).
# DOCX_LLM_PROVIDER=groq
# DOCX_LLM_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
